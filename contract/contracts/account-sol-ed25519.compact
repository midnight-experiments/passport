// ---------------------------------------------------------------------------
// Arm `sol_ed25519`: a Solana wallet as a device and as a grantee, included by
// account.compact. All custody, grant-scope and recovery mutations use the
// existing shared chips.
//
// SCHEME. RFC 8032 PureEdDSA over edwards25519 (Ed25519), the scheme of a
// Solana wallet's `signMessage` (Phantom and others): the wallet signs the raw
// bytes it is given, with no prefix. Verification is the standard library's
// `ed25519Verify<#n>` plus an explicit `R != O` assert (the seam, added with
// the gated circuits).
//
// IDENTITY. The device is the wallet's public key A. The circuit takes A as a
// `Curve25519Point`, whose type admits only points of the prime-order
// subgroup (ZKIR `FromCoordinates` is unsatisfiable outside it, and the
// runtime refuses such points at the type boundary), and relates it in-circuit
// to the 32-byte RFC 8032 encoding the wallet exports (section 5.1.2: y
// little-endian, the low bit of x in bit 255). Entries, boot commitments and
// grant ids bind those 32 bytes, never the point's internal form, so the
// identity a person compares with the wallet is exactly the one hashed.
//
// BLIND (spec FR-013). The 32 bytes are public (they are the Solana address),
// so every entry and grant id also binds the account's blind, a per-account
// secret the client re-derives from the wallet's signature over a readable,
// non-authorising request message (src/wallet/blind.ts):
//   blind    = SHA-256(pad32("midnight:account:blind:sol:v1") || signature(64))
//   entry    = SHA-256(pad32("midnight:account:device:sol:v1") || account
//                      || key(32) || blind(32) || le4(epoch) || le8(counter))
//   boot     = SHA-256(pad32("midnight:account:boot:sol:v1") || salt
//                      || key(32) || blind(32))
//   grant id = SHA-256(pad32("midnight:account:grant:id:sol:v1") || account
//                      || key(32) || blind(32) || origin_hash || le1(slot))
// These are the shared module's width-64 recipes
// (modules/WalletArmDescriptors), so a device of any readable arm derives
// exactly the same entry for a `sol_ed25519` target from its descriptor.
//
// KEY ADMISSIBILITY (spec FR-012; the arm document's acceptance policy).
//   - canonical y < p, on the curve: the client decodes the wallet's 32 bytes
//     strictly before they become a point; the circuit never sees bytes;
//   - prime-order subgroup (small-order and mixed-order keys): the point type
//     (runtime type check; ZKIR FromCoordinates at the prover);
//   - A != O: `require_live_sol_ed25519_key` below (the identity is the only
//     prime-order point whose x-coordinate is zero); `ed25519Verify` asserts
//     the same on every verification.
// ---------------------------------------------------------------------------

import "modules/WalletArmDescriptors";
import "modules/WalletArmRendering";

// ── The 32-byte key ─────────────────────────────────────────────────────────

// Whether a Curve25519 base field element is odd: the low bit of its
// canonical little-endian encoding's first byte (as the standard library's
// curve25519BaseIsOdd, which the library does not export).
circuit sol_ed25519_base_is_odd(x: Curve25519Base): Boolean {
  const b = (x as Bytes<32> as Vector<32, Uint<8>>)[0];
  const b6 = b  >= 128 ? b  - 128 : b;
  const b5 = b6 >= 64  ? b6 - 64  : b6;
  const b4 = b5 >= 32  ? b5 - 32  : b5;
  const b3 = b4 >= 16  ? b4 - 16  : b4;
  const b2 = b3 >= 8   ? b3 - 8   : b3;
  const b1 = b2 >= 4   ? b2 - 4   : b2;
  return (b1 >= 2 ? b1 - 2 : b1) == 1;
}

// The RFC 8032 section 5.1.2 encoding of a point, as the standard library's
// ed25519Encode (not exported) computes it: y below p < 2^255 leaves bit 255
// clear, and x's parity goes there. For a point of the prime-order subgroup
// this is the one canonical encoding a strict decoder accepts, so the map from
// admissible keys to their 32 bytes is one-to-one.
export pure circuit encode_public_key_with_sol_ed25519(pk: Curve25519Point): Bytes<32> {
  const y = curve25519PointY(pk) as Bytes<32> as Vector<32, Uint<8>>;
  const sign = sol_ed25519_base_is_odd(curve25519PointX(pk)) ? 128 : 0;
  return Bytes[y[0],  y[1],  y[2],  y[3],  y[4],  y[5],  y[6],  y[7],
               y[8],  y[9],  y[10], y[11], y[12], y[13], y[14], y[15],
               y[16], y[17], y[18], y[19], y[20], y[21], y[22], y[23],
               y[24], y[25], y[26], y[27], y[28], y[29], y[30],
               (y[31] + sign) as Uint<8>];
}

// Refuses the identity as a key. Every other point a Curve25519Point can hold
// lies in the prime-order subgroup, so this is the whole in-circuit key guard.
circuit require_live_sol_ed25519_key(pk: Curve25519Point): [] {
  assert((curve25519PointX(pk) as Bytes<32>) != pad(32, ""), "device key is the identity");
}

// ── Derivations (the shared module's width-64 recipes) ──────────────────────

export pure circuit derive_boot_commitment_with_sol_ed25519(
  salt:  Bytes<32>,
  pk:    Curve25519Point,
  blind: Bytes<32>,
): Bytes<32> {
  return derive_descriptor_boot_w64(boot_tag_sol_ed25519(), salt,
    encode_public_key_with_sol_ed25519(pk), blind);
}

export pure circuit derive_device_entry_with_sol_ed25519(
  self_addr: ContractAddress,
  pk:        Curve25519Point,
  blind:     Bytes<32>,
  epoch:     Uint<32>,
  counter:   Uint<64>,
): Bytes<32> {
  return derive_descriptor_entry_w64(device_tag_sol_ed25519(), self_addr,
    encode_public_key_with_sol_ed25519(pk), blind, epoch, counter);
}

export pure circuit derive_grant_id_with_sol_ed25519(
  self_addr:   ContractAddress,
  pk:          Curve25519Point,
  blind:       Bytes<32>,
  origin_hash: Bytes<32>,
  slot:        Uint<8>,
): Bytes<32> {
  return derive_descriptor_grant_id_w64(grant_id_tag_sol_ed25519(), self_addr,
    encode_public_key_with_sol_ed25519(pk), blind, origin_hash, slot);
}

// The blind from the wallet's raw 64-byte signature over the request message
// (src/wallet/blind.ts). Computed by the client, before an account exists;
// exported so that every implementation reproduces it with the contract's
// own toolchain. No circuit accepts the request message as an authorisation.
export pure circuit derive_blind_with_sol_ed25519(signature: Bytes<64>): Bytes<32> {
  return derive_blind(blind_tag_sol_ed25519(), signature);
}

// ── Key derivation from a seed (spec Q8) ────────────────────────────────────
//
// RFC 8032 section 5.1.5: h = SHA-512(seed); s = h[0..32] with bits 0, 1, 2
// and 255 cleared and bit 254 set ("clamped"), read little-endian; A = [s]B.
// Returns A and its 32-byte encoding, so a software signer obtains exactly the
// point and the bytes the arm's circuits use. Pure: no proving key, nothing on
// chain. There is deliberately no raw-scalar helper: a Solana secret key is a
// seed, and a seed passed as a scalar gives another key.
//
// The clamped s lies in [2^254, 2^255), above the group order L; the cast to
// Curve25519Scalar reduces it mod L (ZKIR FromBytes32 on a foreign field), and
// [s mod L]B = [s]B because B has order L.
export pure circuit compute_public_key_with_sol_ed25519(seed: Bytes<32>): [Curve25519Point, Bytes<32>] {
  const h = slice<32>(sha512<Bytes<32>>(seed), 0) as Vector<32, Uint<8>>;
  // Clear bits 0..2 of the first byte: subtract its value mod 8.
  const f = h[0];
  const f6 = f  >= 128 ? f  - 128 : f;
  const f5 = f6 >= 64  ? f6 - 64  : f6;
  const f4 = f5 >= 32  ? f5 - 32  : f5;
  const f3 = f4 >= 16  ? f4 - 16  : f4;
  const low = f3 >= 8 ? f3 - 8 : f3;
  // Clear bit 7 and set bit 6 of the last byte.
  const t = h[31];
  const t7 = t >= 128 ? t - 128 : t;
  const top = t7 >= 64 ? t7 : t7 + 64;
  const s = Bytes[(f - low) as Uint<8>, h[1],  h[2],  h[3],  h[4],  h[5],  h[6],  h[7],
                  h[8],  h[9],  h[10], h[11], h[12], h[13], h[14], h[15],
                  h[16], h[17], h[18], h[19], h[20], h[21], h[22], h[23],
                  h[24], h[25], h[26], h[27], h[28], h[29], h[30],
                  top as Uint<8>] as Curve25519Scalar;
  const pk = ecMulGenerator(s);
  return [pk, encode_public_key_with_sol_ed25519(pk)];
}

// ── Bootstrap ───────────────────────────────────────────────────────────────

// Permissionless, as every arm's activation: the boot commitment binds the
// key and the blind, so only the committed device can be activated, and the
// caller learns nothing it did not already hold.
export circuit activate_initial_device_with_sol_ed25519(
  pk:    Curve25519Point,
  salt:  Bytes<32>,
  blind: Bytes<32>,
): [] {
  assert(!booted, "already activated");
  require_live_sol_ed25519_key(pk);
  assert(derive_boot_commitment_with_sol_ed25519(salt, pk, blind) == boot, "boot commitment mismatch");
  do_activate_initial_device(derive_device_entry_with_sol_ed25519(
    kernel.self(), pk, blind, device_epoch, 0 as Uint<64>
  ));
}

// ── Signed messages, format sol v1 (spec FR-S02, FR-S03, FR-004, FR-023) ────
//
// A Solana wallet's `signMessage` signs the raw bytes it is given, so the
// message IS the approval screen. Every gated circuit renders its message
// from the values it executes on, and verifies the wallet's signature over
// exactly those bytes. The grammar (the audited F3 v3 of project 00047,
// generalised):
//
//   Midnight Passport approval (sol v1)       circuit-fixed first line
//   Operation: <title>                        fixed per circuit
//   Site: <label>                             the site's words, marked as such
//   Role: device of this account              or: grantee of a scoped grant
//   Account: <64 hex>                         the account's contract address
//   Signing key: <64 hex>                     the signer's 32-byte Ed25519 key
//   <operation lines>                         every operand and consumed
//                                             witness value, in full
//   Consequence: <...>                        fixed, on authority-granting
//                                             operations
//   Device nonce: <decimal>                   device role: auth_nonce
//   Grant label/slot/issued at/use nonce      grantee role: the grant's
//                                             identity and freshness
//
// Rules: printable ASCII and LF only; every line starts with circuit-fixed
// text; nothing the site chooses can contain a line break or start a line;
// values are shown in full (hex: two lowercase digits per byte, in full;
// decimals: every digit, left-aligned and space-padded to the type's width,
// so each layout has one fixed length); no digest, fingerprint or
// truncation. Decimal digits are display inputs CHECKED against the value
// (WalletArmRendering): for each value exactly one text is valid. The two
// site-chosen texts are the label after "Site: " and, on a moved amount,
// the decimal point and symbol after "This site labels it: "; both are
// checked for shape, and neither can move value. The only hash-like values
// ever shown are the four listed and labelled in the spec (FR-004): a
// k256/jubjub grantee's origin hash ("Grantee site label (hash)"), a
// passkey's RP hash ("Passkey RP (hash)"), a target device's blind ("Device
// privacy salt"), and the literal entry of a revocation-only removal.
//
// No message can be read as a Solana transaction or off-chain message
// (FR-S03): every message starts with "Midn" (77 105 100 110): as a legacy
// message header that claims 110 account keys, i.e. at least
// 3 + 1 + 110*32 + 32 + 1 = 3,557 bytes, and every message here is shorter;
// the first byte is below 0x80 (no versioned message) and is not 0xff (no
// off-chain envelope); as a signed transaction it would carry 77 signatures
// (4,928 bytes). The length table is in the arm document.

// Display inputs. Texts are ASCII bytes; every one is checked against the
// value it describes, so none adds freedom beyond what the comments say.

// Every message: the site's label (zero-padded; visible words separated by
// single spaces) and the decimal digits of the freshness nonce (auth_nonce
// for a device, the grant's nonce for a grantee).
export struct SolShow {
  site:  Bytes<32>;
  nonce: Vector<20, Uint<8>>;
}

// A grantee's freshness: the grant's slot and issued_at in decimal.
export struct SolGrantShow {
  slot:   Vector<3, Uint<8>>;
  issued: Vector<20, Uint<8>>;
}

// A moved amount: its base units in decimal, and the site's label for it:
// "<the same digits with the site's decimal point> <symbol>".
export struct SolAmountShow {
  units: Vector<39, Uint<8>>;
  claim: Vector<49, Uint<8>>;
}

// A spent shielded coin: its value, Merkle index and the change, in decimal.
export struct SolCoinShow {
  value:  Vector<39, Uint<8>>;
  index:  Vector<20, Uint<8>>;
  change: Vector<39, Uint<8>>;
}

// A readable target (add_device, remove_device, issue_grant, revoke_grant):
// the registered tag shown as text and the key payload of its width class.
//   w52  evm_eip712   address (20), a = blind
//   w64  jubjub       a = x_le, b = y_le         sol_ed25519  a = key, b = blind
//   w65  k256         a = x_le, b = y_le, envelope
//   w117 p256         a = x_le, b = y_le, c = rp_id_hash, origin (21)
// (grant ids: p256 is w64, key only). Fields a class does not use must be
// zero, so each target has exactly one encoding.
export struct SolTarget {
  tag:      Bytes<32>;
  address:  Bytes<20>;
  a:        Bytes<32>;
  b:        Bytes<32>;
  c:        Bytes<32>;
  origin:   Bytes<21>;
  envelope: Uint<8>;
}

// The digits of a target's numbers (envelope; removal counter and epoch).
export struct SolTargetShow {
  envelope: Vector<3, Uint<8>>;
  counter:  Vector<20, Uint<8>>;
  epoch:    Vector<10, Uint<8>>;
}

// The digits of a grantee's numbers (issue_grant, revoke_grant).
export struct SolGranteeShow {
  envelope: Vector<3, Uint<8>>;
  slot:     Vector<3, Uint<8>>;
}

// The digits of a grant scope's numbers (issue_grant).
export struct SolScopeShow {
  max_coin:   Vector<39, Uint<8>>;
  per_call:   Vector<39, Uint<8>>;
  cap:        Vector<39, Uint<8>>;
  expires:    Vector<20, Uint<8>>;
  window:     Vector<20, Uint<8>>;
  window_cap: Vector<39, Uint<8>>;
}

// ── Pieces ──────────────────────────────────────────────────────────────────

// The site's label for an amount: "<number> <symbol>", left-aligned and
// space-padded in 49 bytes. <number> is the value's digits with the site's
// decimal point: none, or 1..18 digits after it, at least one before it, no
// leading zero (except a lone "0" before the point); <symbol> is 1..8
// visible characters. The digits read back to the value, so the site
// chooses only the point's position and the symbol (project 00047, F3 v3).
circuit sol_claim_text(value: Field, t: Vector<49, Uint<8>>): Vector<49, Uint<8>> {
  // [value so far, phase (0 integer part, 1 fraction, 2 symbol, 3 padding),
  //  digits before the point, digits after it, symbol length, every byte fits]
  const r = fold((s: [Field, Uint<8>, Uint<8>, Uint<8>, Uint<8>, Boolean], c: Uint<8>):
                 [Field, Uint<8>, Uint<8>, Uint<8>, Uint<8>, Boolean] => {
    const space = c == 32;
    const dot = c == 46;
    const digit = c >= 48 && c <= 57;
    const shown = c >= 33 && c <= 126;
    const p = s[1];
    const whole = p == 0;
    const frac = p == 1;
    const sym = p == 2;
    const ok = whole ? digit || ((dot || space) && s[2] != 0)
             : frac ? digit || (space && s[3] != 0)
             : sym ? shown || (space && s[4] != 0)
             : space;
    const next = whole ? (dot ? 1 : (space ? 2 : 0))
               : frac ? (space ? 2 : 1)
               : sym ? (space ? 3 : 2)
               : 3;
    const number = (whole || frac) && digit;
    return [number ? s[0] * 10 + ((c as Field) - 48) : s[0],
            next as Uint<8>,
            (whole && digit ? s[2] + 1 : s[2]) as Uint<8>,
            (frac && digit ? s[3] + 1 : s[3]) as Uint<8>,
            (sym && shown ? s[4] + 1 : s[4]) as Uint<8>,
            s[5] && ok];
  }, [0 as Field, 0 as Uint<8>, 0 as Uint<8>, 0 as Uint<8>, 0 as Uint<8>, true], t);
  assert(r[5] && (r[1] == 3 || (r[1] == 2 && r[4] != 0)), "display: not a site amount label");
  assert(r[3] <= 18, "display: more than 18 decimals");
  assert(r[4] <= 8, "display: symbol longer than 8");
  assert(t[0] != 48 || t[1] == 46 || t[1] == 32, "display: leading zero");
  assert(r[0] == value, "display: digits do not match the value");
  return t;
}

// A 32-byte value in the usual big-endian form of a little-endian
// coordinate: the hex pairs of the bytes in reverse order (wiring only).
circuit sol_hex_be(le: Bytes<32>): Vector<64, Uint<8>> {
  return hex_text_32(reverse_32(le));
}

// "Midnight Passport approval (sol v1)" and LF.
circuit sol_first_line(): Vector<36, Uint<8>> {
  return [...pad(35, "Midnight Passport approval (sol v1)"), 10];
}

// The lines after the title for the device role (220 bytes):
// Site / Role / Account / Signing key.
circuit sol_device_lines(site: Bytes<32>, self_addr: ContractAddress, key: Bytes<32>): Vector<220, Uint<8>> {
  return [...pad(6, "Site: "), ...label_text_32(site), 10,
          ...pad(28, "Role: device of this account"), 10,
          ...pad(9, "Account: "), ...hex_text_32(self_addr.bytes), 10,
          ...pad(13, "Signing key: "), ...hex_text_32(key), 10];
}

// The same for the grantee role (223 bytes).
circuit sol_grantee_lines(site: Bytes<32>, self_addr: ContractAddress, key: Bytes<32>): Vector<223, Uint<8>> {
  return [...pad(6, "Site: "), ...label_text_32(site), 10,
          ...pad(31, "Role: grantee of a scoped grant"), 10,
          ...pad(9, "Account: "), ...hex_text_32(self_addr.bytes), 10,
          ...pad(13, "Signing key: "), ...hex_text_32(key), 10];
}

// The device role's last line (34 bytes, no LF): the auth_nonce.
circuit sol_device_nonce(nonce_value: Uint<64>, digits: Vector<20, Uint<8>>): Vector<34, Uint<8>> {
  return [...pad(14, "Device nonce: "), ...uint64_text(nonce_value, digits)];
}

// The grantee role's last lines (143 bytes, no final LF): the grant's
// label, slot, issued_at (the account's auth_nonce when it was issued) and
// use nonce.
circuit sol_grant_tail(label: Bytes<32>, slot: Uint<8>, issued_at: Uint<64>, nonce_value: Uint<64>,
                       g: SolGrantShow, nonce: Vector<20, Uint<8>>): Vector<143, Uint<8>> {
  return [...pad(13, "Grant label: "), ...label_text_32(label), 10,
          ...pad(12, "Grant slot: "), ...uint8_text(slot, g.slot), 10,
          ...pad(23, "Grant issued at nonce: "), ...uint64_text(issued_at, g.issued), 10,
          ...pad(17, "Grant use nonce: "), ...uint64_text(nonce_value, nonce)];
}

// A moved amount (204 bytes): the token, the base units, the site's label.
circuit sol_amount_lines(color: Bytes<32>, amount: Uint<128>, a: SolAmountShow): Vector<204, Uint<8>> {
  return [...pad(7, "Token: "), ...hex_text_32(color), 10,
          ...pad(21, "Amount (base units): "), ...uint128_text(amount, a.units), 10,
          ...pad(21, "This site labels it: "), ...sol_claim_text(amount as Field, a.claim), 10];
}

// A spent shielded coin (249 bytes): its value, nonce, Merkle index, and the
// change that returns to this account (value - amount). Its colour is the
// Token line: every shielded export asserts coin.color == color.
circuit sol_coin_lines(coin: QualifiedShieldedCoinInfo, amount: Uint<128>, c: SolCoinShow): Vector<249, Uint<8>> {
  assert(amount <= coin.value, "amount above the spent coin's value");
  return [...pad(18, "Spent coin value: "), ...uint128_text(coin.value, c.value), 10,
          ...pad(18, "Spent coin nonce: "), ...hex_text_32(coin.nonce), 10,
          ...pad(18, "Spent coin index: "), ...uint64_text(coin.mt_index, c.index), 10,
          ...pad(29, "Change back to this account: "), ...uint128_text((coin.value - amount) as Uint<128>, c.change), 10];
}

// A 192-byte inbox ciphertext in full (510 bytes): six lines of 64 hex.
circuit sol_entry_lines(entry: Bytes<192>): Vector<510, Uint<8>> {
  return [...pad(18, "Inbox entry 1 of 6"), 58, 32, ...hex_text_32(slice<32>(entry, 0)), 10,
          ...pad(18, "Inbox entry 2 of 6"), 58, 32, ...hex_text_32(slice<32>(entry, 32)), 10,
          ...pad(18, "Inbox entry 3 of 6"), 58, 32, ...hex_text_32(slice<32>(entry, 64)), 10,
          ...pad(18, "Inbox entry 4 of 6"), 58, 32, ...hex_text_32(slice<32>(entry, 96)), 10,
          ...pad(18, "Inbox entry 5 of 6"), 58, 32, ...hex_text_32(slice<32>(entry, 128)), 10,
          ...pad(18, "Inbox entry 6 of 6"), 58, 32, ...hex_text_32(slice<32>(entry, 160)), 10];
}

// n spaces.
circuit sol_spaces<#n>(): Vector<n, Uint<8>> {
  return map((c: Uint<8>): Uint<8> => (c + 32) as Uint<8>, default<Vector<n, Uint<8>>>);
}

// "yes" or "no " (3 bytes).
circuit sol_yes_no(b: Boolean): Vector<3, Uint<8>> {
  return map((y: Uint<8>, n: Uint<8>): Uint<8> => (b ? y : (n == 0 ? 32 : n)) as Uint<8>,
             pad(3, "yes") as Vector<3, Uint<8>>, pad(3, "no") as Vector<3, Uint<8>>);
}

// ── Readable targets: devices (add_device, remove_device) ───────────────────
//
// One circuit per operation derives the target's entry by the class its tag
// registers (FR-005): 0 evm_eip712 (w52), 1 jubjub (w64), 2 sol_ed25519
// (w64), 3 k256 (w65), 4 p256 (w117). An unregistered tag reaches class 4,
// whose derivation refuses it (the module's tag asserts).
circuit sol_device_class(tag: Bytes<32>): Uint<8> {
  return (tag == device_tag_evm_eip712() ? 0
        : tag == device_tag_jubjub() ? 1
        : tag == device_tag_sol_ed25519() ? 2
        : tag == device_tag_k256() ? 3 : 4) as Uint<8>;
}

// The fields a class does not use must be zero (one encoding per target).
circuit sol_require_canonical_device(t: SolTarget, cls: Uint<8>): [] {
  assert(cls == 0 || t.address == pad(20, ""), "descriptor: unused address must be zero");
  assert(cls == 4 || t.c == pad(32, ""), "descriptor: unused rp hash must be zero");
  assert(cls == 4 || t.origin == pad(21, ""), "descriptor: unused origin must be zero");
  assert(cls == 3 || t.envelope == 0, "descriptor: unused envelope must be zero");
  assert(cls != 0 || t.b == pad(32, ""), "descriptor: unused second field must be zero");
}

// The entry of a target device at (epoch, counter), by its class.
circuit sol_device_entry(t: SolTarget, self_addr: ContractAddress, epoch: Uint<32>, counter: Uint<64>): Bytes<32> {
  const cls = sol_device_class(t.tag);
  sol_require_canonical_device(t, cls);
  if (cls == 0) {
    return derive_descriptor_entry_w52(t.tag, self_addr, t.address, t.a, epoch, counter);
  }
  if (cls == 1 || cls == 2) {
    return derive_descriptor_entry_w64(t.tag, self_addr, t.a, t.b, epoch, counter);
  }
  if (cls == 3) {
    return derive_descriptor_entry_w65(t.tag, self_addr, t.a, t.b, t.envelope, epoch, counter);
  }
  return derive_descriptor_entry_w117(t.tag, self_addr, t.a, t.b, t.c, t.origin, epoch, counter);
}

// The key lines of a target device (282 bytes, every class padded to the
// longest with spaces before its last line break). Keys are shown in the form
// their own wallets show (an EVM address, the 32-byte Solana key, a passkey
// origin) or, for curve points, big-endian coordinates.
circuit sol_device_block(t: SolTarget, cls: Uint<8>, envelope: Vector<3, Uint<8>>): Vector<282, Uint<8>> {
  const ha = hex_text_32(t.a);
  const hb = hex_text_32(t.b);
  const xa = sol_hex_be(t.a);
  const yb = sol_hex_be(t.b);
  const evm = [...pad(20, "Ethereum address: 0x"), ...hex_text_20(t.address), 10,
               ...pad(21, "Device privacy salt: "), ...ha, ...sol_spaces<135>(), 10];
  const jub = [...pad(14, "JubJub key x: "), ...xa, 10,
               ...pad(14, "JubJub key y: "), ...yb, ...sol_spaces<124>(), 10];
  const sol = [...pad(12, "Solana key: "), ...ha, 10,
               ...pad(21, "Device privacy salt: "), ...hb, ...sol_spaces<119>(), 10];
  const k1 = [...pad(17, "secp256k1 key x: "), ...xa, 10,
              ...pad(17, "secp256k1 key y: "), ...yb, 10,
              ...pad(18, "Signing envelope: "), ...uint8_text(t.envelope, envelope), ...sol_spaces<96>(), 10];
  // The origin is checked visible only on the passkey class (others are zero).
  for (const o of t.origin as Vector<21, Uint<8>>) {
    assert(cls != 4 || (o >= 33 && o <= 126), "display: passkey origin not visible ASCII");
  }
  const r1 = [...pad(15, "Passkey key x: "), ...xa, 10,
              ...pad(15, "Passkey key y: "), ...yb, 10,
              ...pad(16, "Passkey origin: "), ...(t.origin as Vector<21, Uint<8>>), 10,
              ...pad(19, "Passkey RP (hash): "), ...hex_text_32(t.c), 10];
  return map((e: Uint<8>, j: Uint<8>, s: Uint<8>, k: Uint<8>, p: Uint<8>): Uint<8> =>
               cls == 0 ? e : cls == 1 ? j : cls == 2 ? s : cls == 3 ? k : p,
             evm, jub, sol, k1, r1);
}

// ── Readable targets: grantees (issue_grant, revoke_grant) ──────────────────
//
// A grantee's grant id uses its scheme's grant-id recipe (key, origin_hash,
// slot). Classes: 0 evm_eip712 (w52), 1 jubjub (w64), 2 sol_ed25519 (w64),
// 3 k256 (w65), 4 p256 (w64, key only; its RP is a scope field). The
// origin_hash: a readable grantee's 32-byte label (shown as text), a
// passkey's 21-byte origin (shown as text), or, for k256/jubjub grantees,
// the labelled hash itself (spec Q17).
export struct SolGrantee {
  tag:         Bytes<32>;
  address:     Bytes<20>;
  a:           Bytes<32>;
  b:           Bytes<32>;
  envelope:    Uint<8>;
  label:       Bytes<32>;
  origin:      Bytes<21>;
  origin_hash: Bytes<32>;
  slot:        Uint<8>;
}

circuit sol_grantee_class(tag: Bytes<32>): Uint<8> {
  return (tag == grant_id_tag_evm_eip712() ? 0
        : tag == grant_id_tag_jubjub() ? 1
        : tag == grant_id_tag_sol_ed25519() ? 2
        : tag == grant_id_tag_k256() ? 3 : 4) as Uint<8>;
}

// The grantee's origin_hash by class, the unused fields zero.
circuit sol_grantee_origin_hash(t: SolGrantee, cls: Uint<8>): Bytes<32> {
  assert(cls == 0 || t.address == pad(20, ""), "descriptor: unused address must be zero");
  assert(cls != 0 || t.b == pad(32, ""), "descriptor: unused second field must be zero");
  assert(cls == 3 || t.envelope == 0, "descriptor: unused envelope must be zero");
  const readable = cls == 0 || cls == 2;
  assert(readable || t.label == pad(32, ""), "descriptor: unused label must be zero");
  assert(cls == 4 || t.origin == pad(21, ""), "descriptor: unused origin must be zero");
  if (readable) {
    assert(t.origin_hash == pad(32, ""), "descriptor: a readable grantee's origin hash is derived");
    return derive_grant_origin_hash_label(t.label);
  }
  if (cls == 4) {
    assert(t.origin_hash == pad(32, ""), "descriptor: a passkey grantee's origin hash is derived");
    return derive_grant_origin_hash_origin(t.origin);
  }
  return t.origin_hash;
}

circuit sol_grantee_id(t: SolGrantee, cls: Uint<8>, self_addr: ContractAddress, origin_hash: Bytes<32>): Bytes<32> {
  if (cls == 0) {
    return derive_descriptor_grant_id_w52(t.tag, self_addr, t.address, t.a, origin_hash, t.slot);
  }
  if (cls == 3) {
    return derive_descriptor_grant_id_w65(t.tag, self_addr, t.a, t.b, t.envelope, origin_hash, t.slot);
  }
  return derive_descriptor_grant_id_w64(t.tag, self_addr, t.a, t.b, origin_hash, t.slot);
}

// The grantee's key and origin lines (278 bytes, padded as the device block).
circuit sol_grantee_block(t: SolGrantee, cls: Uint<8>, envelope: Vector<3, Uint<8>>): Vector<278, Uint<8>> {
  const ha = hex_text_32(t.a);
  const hb = hex_text_32(t.b);
  const xa = sol_hex_be(t.a);
  const yb = sol_hex_be(t.b);
  // Only a readable grantee (evm, sol) has a label; the others carry zero,
  // which the label grammar refuses, so a fixed stand-in is rendered for them
  // and never shown.
  const lab = label_text_32(cls == 0 || cls == 2 ? t.label : pad(32, "-"));
  const oh = hex_text_32(t.origin_hash);
  const evm = [...pad(20, "Ethereum address: 0x"), ...hex_text_20(t.address), 10,
               ...pad(21, "Device privacy salt: "), ...ha, 10,
               ...pad(15, "Grantee label: "), ...lab, ...sol_spaces<83>(), 10];
  const jub = [...pad(14, "JubJub key x: "), ...xa, 10,
               ...pad(14, "JubJub key y: "), ...yb, 10,
               ...pad(27, "Grantee site label (hash): "), ...oh, ...sol_spaces<28>(), 10];
  const sol = [...pad(12, "Solana key: "), ...ha, 10,
               ...pad(21, "Device privacy salt: "), ...hb, 10,
               ...pad(15, "Grantee label: "), ...lab, ...sol_spaces<67>(), 10];
  const k1 = [...pad(17, "secp256k1 key x: "), ...xa, 10,
              ...pad(17, "secp256k1 key y: "), ...yb, 10,
              ...pad(18, "Signing envelope: "), ...uint8_text(t.envelope, envelope), 10,
              ...pad(27, "Grantee site label (hash): "), ...oh, 10];
  for (const o of t.origin as Vector<21, Uint<8>>) {
    assert(cls != 4 || (o >= 33 && o <= 126), "display: passkey origin not visible ASCII");
  }
  const r1 = [...pad(15, "Passkey key x: "), ...xa, 10,
              ...pad(15, "Passkey key y: "), ...yb, 10,
              ...pad(16, "Passkey origin: "), ...(t.origin as Vector<21, Uint<8>>), ...sol_spaces<80>(), 10];
  return map((e: Uint<8>, j: Uint<8>, s: Uint<8>, k: Uint<8>, p: Uint<8>): Uint<8> =>
               cls == 0 ? e : cls == 1 ? j : cls == 2 ? s : cls == 3 ? k : p,
             evm, jub, sol, k1, r1);
}

// The two forms of a removal, one length (396 bytes): the descriptor form
// (scheme, key lines, use counter, epoch) or the revocation-only literal form
// (spec Q20), padded with spaces before its last line break.
circuit sol_remove_lines(literal: Boolean, target: SolTarget, counter: Uint<64>, epoch: Uint<32>, entry: Bytes<32>, ts: SolTargetShow): Vector<396, Uint<8>> {
  const d = [...pad(15, "Device scheme: "), ...label_text_32(target.tag), 10, ...sol_device_block(target, sol_device_class(target.tag), ts.envelope), ...pad(20, "Device use counter: "), ...uint64_text(counter, ts.counter), 10, ...pad(14, "Device epoch: "), ...uint32_text(epoch, ts.epoch), 10];
  const l = [...pad(44, "Removes a device this wallet cannot identify"), 10, ...pad(14, "Device entry: "), ...hex_text_32(entry), ...sol_spaces<272>(), 10];
  return map((x: Uint<8>, y: Uint<8>): Uint<8> => literal ? y : x, d, l);
}

// The recipient kind as a word (18 bytes): 0 any, 1 unshielded address,
// 2 shielded key, 3 contract. Other kinds are refused (a grant with one
// could never spend).
circuit sol_recipient_kind(kind: Uint<8>): Vector<18, Uint<8>> {
  assert(kind <= 3, "display: unknown recipient kind");
  return map((a: Uint<8>, u: Uint<8>, s: Uint<8>, c: Uint<8>): Uint<8> =>
               (kind == 0 ? (a == 0 ? 32 : a) : kind == 1 ? (u == 0 ? 32 : u) : kind == 2 ? (s == 0 ? 32 : s) : (c == 0 ? 32 : c)) as Uint<8>,
             pad(18, "any recipient") as Vector<18, Uint<8>>, pad(18, "unshielded address") as Vector<18, Uint<8>>,
             pad(18, "shielded key") as Vector<18, Uint<8>>, pad(18, "contract") as Vector<18, Uint<8>>);
}

// ── The messages: one pure circuit per operation and role ─────────────────────
//
// Exported, and therefore free (no proving key): a dApp, a relay or an
// auditor obtains the contract's own bytes for any call, and
// src/wallet/sol-ed25519-message.ts is an independent TypeScript renderer
// held byte for byte to these (src/tests/sol-ed25519-message-offline.ts).

// Rotate the encryption key (device role): 511 bytes.
export pure circuit sol_message_rotate_enc_key(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, new_key: Bytes<32>, show: SolShow
): Bytes<511> {
  return Bytes[...sol_first_line(),
               ...pad(36, "Operation: Rotate the encryption key"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...pad(20, "New encryption key: "),
               ...hex_text_32(new_key),
               10,
               ...pad(98, "Consequence: coins deposited from now on are encrypted to this key; only its holder can read them."),
               10,
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Append an inbox entry (device role): 833 bytes.
export pure circuit sol_message_append_inbox(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, entry: Bytes<192>, show: SolShow
): Bytes<833> {
  return Bytes[...sol_first_line(),
               ...pad(32, "Operation: Append an inbox entry"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...sol_entry_lines(entry),
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Withdraw unshielded tokens (device role): 620 bytes.
export pure circuit sol_message_withdraw_unshielded(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, color: Bytes<32>, amount: Uint<128>, recipient: UserAddress, a: SolAmountShow, show: SolShow
): Bytes<620> {
  return Bytes[...sol_first_line(),
               ...pad(37, "Operation: Withdraw unshielded tokens"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...sol_amount_lines(color, amount, a),
               ...pad(23, "To unshielded address: "),
               ...hex_text_32(recipient.bytes),
               10,
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Withdraw shielded tokens (device role): 861 bytes.
export pure circuit sol_message_withdraw_shielded(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, recipient: ZswapCoinPublicKey, color: Bytes<32>, amount: Uint<128>, coin: QualifiedShieldedCoinInfo, a: SolAmountShow, c: SolCoinShow, show: SolShow
): Bytes<861> {
  return Bytes[...sol_first_line(),
               ...pad(35, "Operation: Withdraw shielded tokens"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...sol_amount_lines(color, amount, a),
               ...pad(17, "To shielded key: "),
               ...hex_text_32(recipient.bytes),
               10,
               ...sol_coin_lines(coin, amount, c),
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Withdraw shielded tokens to a contract (device role): 871 bytes.
export pure circuit sol_message_withdraw_shielded_to_contract(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, recipient: ContractAddress, color: Bytes<32>, amount: Uint<128>, coin: QualifiedShieldedCoinInfo, a: SolAmountShow, c: SolCoinShow, show: SolShow
): Bytes<871> {
  return Bytes[...sol_first_line(),
               ...pad(49, "Operation: Withdraw shielded tokens to a contract"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...sol_amount_lines(color, amount, a),
               ...pad(13, "To contract: "),
               ...hex_text_32(recipient.bytes),
               10,
               ...sol_coin_lines(coin, amount, c),
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Add a device (device role): 705 bytes.
export pure circuit sol_message_add_device(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, target: SolTarget, ts: SolTargetShow, show: SolShow
): Bytes<705> {
  return Bytes[...sol_first_line(),
               ...pad(23, "Operation: Add a device"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...pad(60, "Consequence: gives this device FULL control of this account."),
               10,
               ...pad(15, "Device scheme: "),
               ...label_text_32(target.tag),
               10,
               ...sol_device_block(target, sol_device_class(target.tag), ts.envelope),
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Remove a device (device role): 781 bytes.
export pure circuit sol_message_remove_device(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, literal: Boolean, target: SolTarget, counter: Uint<64>, epoch: Uint<32>, entry: Bytes<32>, ts: SolTargetShow, show: SolShow
): Bytes<781> {
  return Bytes[...sol_first_line(),
               ...pad(26, "Operation: Remove a device"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...pad(67, "Consequence: the removed device can no longer act for this account."),
               10,
               ...sol_remove_lines(literal, target, counter, epoch, entry, ts),
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Issue a scoped grant (device role): 1646 bytes.
export pure circuit sol_message_issue_grant(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, grantee: SolGrantee, op_withdraw_unshielded: Boolean, op_withdraw_shielded: Boolean, op_withdraw_shielded_to_contract: Boolean, read: Boolean, color: Bytes<32>, recipient_kind: Uint<8>, recipient: Bytes<32>, max_coin_value: Uint<128>, per_call_cap: Uint<128>, cap: Uint<128>, expires_at: Uint<64>, rp_id_hash: Bytes<32>, read_pk: Bytes<32>, window_len: Uint<64>, window_cap: Uint<128>, caller: Maybe<ContractAddress>, gs: SolGranteeShow, ss: SolScopeShow, show: SolShow
): Bytes<1646> {
  return Bytes[...sol_first_line(),
               ...pad(31, "Operation: Issue a scoped grant"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...pad(84, "Consequence: lets the grantee key below spend from this account within these limits."),
               10,
               ...pad(16, "Grantee scheme: "),
               ...label_text_32(grantee.tag),
               10,
               ...sol_grantee_block(grantee, sol_grantee_class(grantee.tag), gs.envelope),
               ...pad(14, "Grantee slot: "),
               ...uint8_text(grantee.slot, gs.slot),
               10,
               ...pad(25, "May withdraw unshielded: "),
               ...sol_yes_no(op_withdraw_unshielded),
               10,
               ...pad(23, "May withdraw shielded: "),
               ...sol_yes_no(op_withdraw_shielded),
               10,
               ...pad(37, "May withdraw shielded to a contract: "),
               ...sol_yes_no(op_withdraw_shielded_to_contract),
               10,
               ...pad(20, "May read the inbox: "),
               ...sol_yes_no(read),
               10,
               ...pad(7, "Token: "),
               ...hex_text_32(color),
               10,
               ...pad(16, "Recipient kind: "),
               ...sol_recipient_kind(recipient_kind),
               10,
               ...pad(11, "Recipient: "),
               ...hex_text_32(recipient),
               10,
               ...pad(16, "Max coin value: "),
               ...uint128_text(max_coin_value, ss.max_coin),
               10,
               ...pad(14, "Per-call cap: "),
               ...uint128_text(per_call_cap, ss.per_call),
               10,
               ...pad(11, "Total cap: "),
               ...uint128_text(cap, ss.cap),
               10,
               ...pad(45, "Expires at (block time, seconds; 0 = never): "),
               ...uint64_text(expires_at, ss.expires),
               10,
               ...pad(19, "Passkey RP (hash): "),
               ...hex_text_32(rp_id_hash),
               10,
               ...pad(16, "Inbox read key: "),
               ...hex_text_32(read_pk),
               10,
               ...pad(15, "Window length: "),
               ...uint64_text(window_len, ss.window),
               10,
               ...pad(12, "Window cap: "),
               ...uint128_text(window_cap, ss.window_cap),
               10,
               ...pad(33, "Caller restricted to a contract: "),
               ...sol_yes_no(caller.is_some),
               10,
               ...pad(8, "Caller: "),
               ...hex_text_32(caller.value.bytes),
               10,
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Revoke a scoped grant (device role): 729 bytes.
export pure circuit sol_message_revoke_grant(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, grantee: SolGrantee, gs: SolGranteeShow, show: SolShow
): Bytes<729> {
  return Bytes[...sol_first_line(),
               ...pad(32, "Operation: Revoke a scoped grant"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...pad(60, "Consequence: the grantee can no longer act under this grant."),
               10,
               ...pad(16, "Grantee scheme: "),
               ...label_text_32(grantee.tag),
               10,
               ...sol_grantee_block(grantee, sol_grantee_class(grantee.tag), gs.envelope),
               ...pad(14, "Grantee slot: "),
               ...uint8_text(grantee.slot, gs.slot),
               10,
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Revoke all scoped grants (device role): 389 bytes.
export pure circuit sol_message_revoke_all_grants(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, show: SolShow
): Bytes<389> {
  return Bytes[...sol_first_line(),
               ...pad(35, "Operation: Revoke all scoped grants"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...pad(62, "Consequence: every scoped grant of this account stops working."),
               10,
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Publish a recovery session (device role): 1250 bytes.
export pure circuit sol_message_publish_recovery_session(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, new_recovery_pk: JubjubPoint, session_nonce: Bytes<32>, phi_1: Field, phi_2: Field, phi_3: Field, phi_4: Field, phi_len: Uint<8>, wrap: Bytes<64>, phi_len_digits: Vector<3, Uint<8>>, show: SolShow
): Bytes<1250> {
  return Bytes[...sol_first_line(),
               ...pad(37, "Operation: Publish a recovery session"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...pad(107, "Consequence: sets this account's recovery key; its holder can take over this account after the veto window."),
               10,
               ...pad(16, "Recovery key x: "),
               ...sol_hex_be(jubjubPointX(new_recovery_pk) as Bytes<32>),
               10,
               ...pad(16, "Recovery key y: "),
               ...sol_hex_be(jubjubPointY(new_recovery_pk) as Bytes<32>),
               10,
               ...pad(15, "Session nonce: "),
               ...hex_text_32(session_nonce),
               10,
               ...pad(28, "Backup vector value 1 of 4: "),
               ...sol_hex_be(phi_1 as Bytes<32>),
               10,
               ...pad(28, "Backup vector value 2 of 4: "),
               ...sol_hex_be(phi_2 as Bytes<32>),
               10,
               ...pad(28, "Backup vector value 3 of 4: "),
               ...sol_hex_be(phi_3 as Bytes<32>),
               10,
               ...pad(28, "Backup vector value 4 of 4: "),
               ...sol_hex_be(phi_4 as Bytes<32>),
               10,
               ...pad(22, "Backup vector length: "),
               ...uint8_text(phi_len, phi_len_digits),
               10,
               ...pad(22, "Key wrap part 1 of 2: "),
               ...hex_text_32(slice<32>(wrap, 0)),
               10,
               ...pad(22, "Key wrap part 2 of 2: "),
               ...hex_text_32(slice<32>(wrap, 32)),
               10,
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Cancel a pending recovery (device role): 391 bytes.
export pure circuit sol_message_recover_cancel(
  self_addr: ContractAddress, key: Bytes<32>, nonce_value: Uint<64>, show: SolShow
): Bytes<391> {
  return Bytes[...sol_first_line(),
               ...pad(36, "Operation: Cancel a pending recovery"),
               10,
               ...sol_device_lines(show.site, self_addr, key),
               ...pad(63, "Consequence: the pending recovery of this account is cancelled."),
               10,
               ...sol_device_nonce(nonce_value, show.nonce)];
}

// Withdraw unshielded tokens under a grant (grantee role): 746 bytes.
export pure circuit sol_message_withdraw_unshielded_with_grant(
  self_addr: ContractAddress, key: Bytes<32>, label: Bytes<32>, slot: Uint<8>, issued_at: Uint<64>, nonce_value: Uint<64>, color: Bytes<32>, amount: Uint<128>, recipient: UserAddress, a: SolAmountShow, show: SolShow, g: SolGrantShow
): Bytes<746> {
  return Bytes[...sol_first_line(),
               ...pad(51, "Operation: Withdraw unshielded tokens under a grant"),
               10,
               ...sol_grantee_lines(show.site, self_addr, key),
               ...sol_amount_lines(color, amount, a),
               ...pad(23, "To unshielded address: "),
               ...hex_text_32(recipient.bytes),
               10,
               ...sol_grant_tail(label, slot, issued_at, nonce_value, g, show.nonce)];
}

// Withdraw shielded tokens under a grant (grantee role): 1586 bytes.
export pure circuit sol_message_withdraw_shielded_with_grant(
  self_addr: ContractAddress, key: Bytes<32>, label: Bytes<32>, slot: Uint<8>, issued_at: Uint<64>, nonce_value: Uint<64>, recipient: ZswapCoinPublicKey, color: Bytes<32>, amount: Uint<128>, change_entry: Bytes<192>, enc_pk: Bytes<32>, coin: QualifiedShieldedCoinInfo, a: SolAmountShow, c: SolCoinShow, show: SolShow, g: SolGrantShow
): Bytes<1586> {
  return Bytes[...sol_first_line(),
               ...pad(49, "Operation: Withdraw shielded tokens under a grant"),
               10,
               ...sol_grantee_lines(show.site, self_addr, key),
               ...sol_amount_lines(color, amount, a),
               ...pad(17, "To shielded key: "),
               ...hex_text_32(recipient.bytes),
               10,
               ...pad(21, "Change entry 1 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 0)),
               10,
               ...pad(21, "Change entry 2 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 32)),
               10,
               ...pad(21, "Change entry 3 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 64)),
               10,
               ...pad(21, "Change entry 4 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 96)),
               10,
               ...pad(21, "Change entry 5 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 128)),
               10,
               ...pad(21, "Change entry 6 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 160)),
               10,
               ...pad(18, "Change entry key: "),
               ...hex_text_32(enc_pk),
               10,
               ...sol_coin_lines(coin, amount, c),
               ...sol_grant_tail(label, slot, issued_at, nonce_value, g, show.nonce)];
}

// Withdraw shielded tokens to a contract under a grant (grantee role): 1596 bytes.
export pure circuit sol_message_withdraw_shielded_to_contract_with_grant(
  self_addr: ContractAddress, key: Bytes<32>, label: Bytes<32>, slot: Uint<8>, issued_at: Uint<64>, nonce_value: Uint<64>, recipient: ContractAddress, color: Bytes<32>, amount: Uint<128>, change_entry: Bytes<192>, enc_pk: Bytes<32>, coin: QualifiedShieldedCoinInfo, a: SolAmountShow, c: SolCoinShow, show: SolShow, g: SolGrantShow
): Bytes<1596> {
  return Bytes[...sol_first_line(),
               ...pad(63, "Operation: Withdraw shielded tokens to a contract under a grant"),
               10,
               ...sol_grantee_lines(show.site, self_addr, key),
               ...sol_amount_lines(color, amount, a),
               ...pad(13, "To contract: "),
               ...hex_text_32(recipient.bytes),
               10,
               ...pad(21, "Change entry 1 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 0)),
               10,
               ...pad(21, "Change entry 2 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 32)),
               10,
               ...pad(21, "Change entry 3 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 64)),
               10,
               ...pad(21, "Change entry 4 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 96)),
               10,
               ...pad(21, "Change entry 5 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 128)),
               10,
               ...pad(21, "Change entry 6 of 6: "),
               ...hex_text_32(slice<32>(change_entry, 160)),
               10,
               ...pad(18, "Change entry key: "),
               ...hex_text_32(enc_pk),
               10,
               ...sol_coin_lines(coin, amount, c),
               ...sol_grant_tail(label, slot, issued_at, nonce_value, g, show.nonce)];
}
