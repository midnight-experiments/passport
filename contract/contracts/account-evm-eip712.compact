// EVM / EIP-712 arm (`evm_eip712`), included by account.compact. All custody,
// grant-scope and recovery mutations use the existing shared chips; this file
// adds the arm's identity, its derivations, its activation and (in later
// steps) its readable EIP-712 approvals and its seam.
//
// THE DEVICE IS ITS ETHEREUM ADDRESS, BLINDED. An ordinary Ethereum account
// (MetaMask, or any EIP-712 wallet) is the device. Its identity is the 20-byte
// `secp256k1EthereumAddress(pk)`, the value the wallet shows, and every
// derivation binds it together with the account's BLIND, a 32-byte secret the
// client re-derives from a deterministic wallet signature over a readable,
// non-authorising request message (spec FR-013; the request is signed with
// `personal_sign`, so it can never be an EIP-712 authorisation):
//
//   entry    = H(pad32("midnight:account:device:evm:v2") || account
//                || address(20) || blind(32) || le4(epoch) || le8(counter))
//   boot     = H(pad32("midnight:account:boot:evm:v2") || salt
//                || address(20) || blind(32))
//   grant id = H(pad32("midnight:account:grant:id:evm:v2") || account
//                || address(20) || blind(32) || origin_hash || slot)
//
// (H = persistentHash = SHA-256 of the plain concatenation.) The recipes live
// in the shared descriptor module (modules/WalletArmDescriptors, width class
// 52), so that every readable arm derives an `evm_eip712` target's entry
// exactly as this arm does. Without the blind, anyone could test a public
// address against every account's entries; with it, the ledger holds nothing
// a known address can be tested against. The blind is a private input of
// every proof and is never disclosed.
//
// THE ADDRESS IS ALWAYS DERIVED FROM THE PRESENTED POINT. Every path that
// admits a key (activation here; the device and grantee seams later) takes
// the secp256k1 point and derives the address itself
// (`evm_eip712_address`), after refusing the point at infinity by its
// COORDINATES, so that both encodings of the identity ({0, 0, identity} and
// {0, 0, not identity}) are refused, as upstream's `require_live_k256_key`
// does. A caller can therefore never present an address it did not prove a
// key for.
//
// Tags: the arm hashes four tags, all registered in the descriptor module
// (`midnight:account:{device,boot,grant:id,blind}:evm:v2`); the `evm` marker
// starts at v2 because the experimental fork used v1 with other preimages.

import "modules/WalletArmDescriptors";
import "modules/EvmEip712";

// The descriptor module's derivations and tags, re-exported as pure circuits
// of the account contract: a client derives any readable descriptor's entry,
// boot commitment, or grant id through the account's own compiled module.
// Pure: no proving key, no deploy cost.
export {
  device_tag_jubjub, device_tag_k256, device_tag_p256,
  device_tag_evm_eip712, device_tag_sol_ed25519,
  boot_tag_jubjub, boot_tag_k256, boot_tag_p256,
  boot_tag_evm_eip712, boot_tag_sol_ed25519,
  grant_id_tag_jubjub, grant_id_tag_k256, grant_id_tag_p256,
  grant_id_tag_evm_eip712, grant_id_tag_sol_ed25519,
  blind_tag_evm_eip712, blind_tag_sol_ed25519, grant_origin_tag,
  derive_descriptor_entry_w52, derive_descriptor_entry_w64,
  derive_descriptor_entry_w65, derive_descriptor_entry_w117,
  derive_descriptor_boot_w52, derive_descriptor_boot_w64,
  derive_descriptor_boot_w65, derive_descriptor_boot_w117,
  derive_descriptor_grant_id_w52, derive_descriptor_grant_id_w64,
  derive_descriptor_grant_id_w65,
  derive_grant_origin_hash_label, derive_grant_origin_hash_origin,
  derive_blind,
};

// The arm's EIP-712 codec (modules/EvmEip712, byte contract EVM-EIP712.md):
// the domain, the digest, the descriptor hashes and derivations, and the
// struct hash of every operation, re-exported as pure oracles.
export {
  EvmEip712Descriptor, EvmEip712GranteeDescriptor,
  evm_eip712_verifying_contract, evm_eip712_domain_separator, evm_eip712_digest,
  evm_eip712_site_label_hash, evm_eip712_device_scheme, evm_eip712_grantee_scheme,
  evm_eip712_device_descriptor_hash, evm_eip712_descriptor_entry,
  evm_eip712_grantee_origin_hash, evm_eip712_grantee_grant_id, evm_eip712_grantee_descriptor_hash,
  evm_eip712_struct_withdraw_unshielded, evm_eip712_struct_withdraw_shielded,
  evm_eip712_struct_withdraw_shielded_to_contract, evm_eip712_struct_append_inbox,
  evm_eip712_struct_rotate_enc_key, evm_eip712_struct_add_device, evm_eip712_struct_remove_device,
  evm_eip712_struct_remove_unknown_device, evm_eip712_struct_issue_grant, evm_eip712_struct_revoke_grant,
  evm_eip712_struct_revoke_all_grants, evm_eip712_struct_publish_recovery_session,
  evm_eip712_struct_cancel_recovery, evm_eip712_struct_withdraw_unshielded_as_grantee,
  evm_eip712_struct_withdraw_shielded_as_grantee, evm_eip712_struct_withdraw_shielded_to_contract_as_grantee,
};

// ── Keys ────────────────────────────────────────────────────────────────────

// Q8: scalar-to-point on secp256k1, for software signers and degenerate-key
// vectors (MetaMask keys never reach a client as scalars: the client recovers
// the point from a wallet signature). The same curve as the k256 arm.
export pure circuit compute_public_point_with_evm_eip712(scalar: Secp256k1Scalar): Secp256k1Point {
  return ecMulGenerator(scalar);
}

// The device's address, derived from the presented point. Refuses the point
// at infinity by its coordinates first, so the unflagged encoding
// {0, 0, not identity} is refused here too (the stdlib's own guard inside
// secp256k1EthereumAddress compares the whole struct, flag included).
// Exported so that clients and tests obtain the address through the
// contract's own code.
export pure circuit evm_eip712_address(pk: Secp256k1Point): Bytes<20> {
  assert(
    !((secp256k1PointX(pk) as Bytes<32>) == pad(32, "")
      && (secp256k1PointY(pk) as Bytes<32>) == pad(32, "")),
    "evm_eip712: device key is the point at infinity"
  );
  return secp256k1EthereumAddress(pk);
}

// ── Derivations (width class 52 of the descriptor module) ──────────────────

export pure circuit derive_boot_commitment_with_evm_eip712(
  salt:    Bytes<32>,
  address: Bytes<20>,
  blind:   Bytes<32>,
): Bytes<32> {
  return derive_descriptor_boot_w52(boot_tag_evm_eip712(), salt, address, blind);
}

export pure circuit derive_device_entry_with_evm_eip712(
  self_addr: ContractAddress,
  address:   Bytes<20>,
  blind:     Bytes<32>,
  epoch:     Uint<32>,
  counter:   Uint<64>,
): Bytes<32> {
  return derive_descriptor_entry_w52(device_tag_evm_eip712(), self_addr, address, blind, epoch, counter);
}

export pure circuit derive_grant_id_with_evm_eip712(
  self_addr:   ContractAddress,
  address:     Bytes<20>,
  blind:       Bytes<32>,
  origin_hash: Bytes<32>,
  slot:        Uint<8>,
): Bytes<32> {
  return derive_descriptor_grant_id_w52(grant_id_tag_evm_eip712(), self_addr, address, blind, origin_hash, slot);
}

// ── Bootstrap ───────────────────────────────────────────────────────────────

// Permissionless, as on every arm: only the committed key can activate, so
// the circuit cannot be front-run to register a foreign key. The caller
// presents the device's POINT (recovered by the client from the blind-request
// signature), the boot salt, and the blind; the address is derived here.
export circuit activate_initial_device_with_evm_eip712(
  pk:    Secp256k1Point,
  salt:  Bytes<32>,
  blind: Bytes<32>,
): [] {
  assert(!booted, "already activated");
  const address = evm_eip712_address(pk);
  assert(derive_boot_commitment_with_evm_eip712(salt, address, blind) == boot,
         "boot commitment mismatch");
  do_activate_initial_device(derive_device_entry_with_evm_eip712(
    kernel.self(), address, blind, device_epoch, 0 as Uint<64>
  ));
}

// ── The authorisation seam (device role) ────────────────────────────────────
//
// The authorising material of every device-gated circuit, its trailing
// argument (kept internal, as P256Auth is). `pk` is the device's point;
// `use_counter` and `blind` are the ledger-pinned openings of the device's
// rolling entry: the membership assert checks them, and they are never shown.
struct EvmEip712Auth {
  pk:          Secp256k1Point;
  use_counter: Uint<64>;
  blind:       Bytes<32>;
  sig:         Secp256k1EcdsaSignature;
}

// Upstream p256's order (MIP-0013 §4, spec FR-007): membership of the
// single-use entry at the active epoch, verification, the entry rolled to its
// successor, auth_nonce advanced, round bumped; any failure aborts the whole
// call.
//
// THE SEAM OWNS THE FRAME (audit G1E-1, G0 C9). An export passes only its
// operation's type hash and tail (from the module's `evm_eip712_parts_*`,
// the same circuits the exported oracles use); the seam derives the device's
// address from the presented point (evm_eip712_address, FR-011: the point at
// infinity refused in both encodings), and supplies the frame's account
// (kernel.self()), device (that address) and authNonce (the ledger's, before
// this call advances it). No export can therefore name an account, a device
// or a nonce: an entry is matched, and a signature verified, only for the
// address of the key that signed.
//
// Two entry points: require_authorised_with_evm_eip712 (one message type)
// and require_authorised_with_evm_eip712_either (remove_device's two forms,
// Q20: the message is the second type when `second`). Both derive the
// address and build their frames themselves, then hand the address they
// derived and the struct hash they built to evm_eip712_verify_and_roll,
// which nothing else calls (the offline suite checks the call sites).
//
// The signature is verified against the EIP-712 digest. secp256k1EcdsaVerify
// accepts both S forms (FIPS 186-5): the rolling entry, consumed by this call,
// makes a malleated twin single-use, as on the k256 arm. r = 0 and s = 0 are
// refused here explicitly (audit C14, R2-12): with s = 0 the stdlib's inverse
// has no meaning, and r = 0 can only match the point at infinity.
//
// Each returns the caller's post-roll entry (remove_device's S13 guard).
circuit require_authorised_with_evm_eip712<T>(auth: EvmEip712Auth, type_hash: Bytes<32>, tail: T): Bytes<32> {
  const address = evm_eip712_address(auth.pk);
  return evm_eip712_verify_and_roll(auth, address,
    evm_eip712_device_struct<T>(type_hash, kernel.self().bytes, address, auth_nonce, tail));
}

circuit require_authorised_with_evm_eip712_either<T, U>(
  auth: EvmEip712Auth, second: Boolean, type_1: Bytes<32>, tail_1: T, type_2: Bytes<32>, tail_2: U
): Bytes<32> {
  const address = evm_eip712_address(auth.pk);
  const h1 = evm_eip712_device_struct<T>(type_1, kernel.self().bytes, address, auth_nonce, tail_1);
  const h2 = evm_eip712_device_struct<U>(type_2, kernel.self().bytes, address, auth_nonce, tail_2);
  return evm_eip712_verify_and_roll(auth, address, second ? h2 : h1);
}

// Internal to the two entry points above: `address` is the one they derived
// from auth.pk, `struct_hash` the one they built from their own frame.
circuit evm_eip712_verify_and_roll(auth: EvmEip712Auth, address: Bytes<20>, struct_hash: Bytes<32>): Bytes<32> {
  const entry = disclose(derive_device_entry_with_evm_eip712(
    kernel.self(), address, auth.blind, device_epoch, auth.use_counter
  ));
  assert(devices.member(entry), "unknown device entry");
  assert(auth.sig.r != default<Secp256k1Scalar> && auth.sig.s != default<Secp256k1Scalar>,
         "evm_eip712: signature scalar is zero");
  assert(secp256k1EcdsaVerify(evm_eip712_digest(kernel.self().bytes, struct_hash), auth.sig, auth.pk),
         "invalid signature");
  devices.remove(entry);
  const next = disclose(derive_device_entry_with_evm_eip712(
    kernel.self(), address, auth.blind, device_epoch, (auth.use_counter + 1) as Uint<64>
  ));
  devices.insert(next);
  auth_nonce = (auth_nonce + 1) as Uint<64>;
  bump_round();
  return next;
}

// ── Custody: the encryption key ─────────────────────────────────────────────

// RotateEncKey(bytes32 account,address device,uint64 authNonce,string effect,bytes32 newKey)
export circuit rotate_enc_key_with_evm_eip712(new_key: Bytes<32>, auth: EvmEip712Auth): [] {
  const [t, tail] = evm_eip712_parts_rotate_enc_key(new_key);
  require_authorised_with_evm_eip712<[Bytes<32>, Bytes<32>]>(auth, t, tail);
  do_rotate_enc_key(new_key);
}

// ── Custody: unshielded (MIP-0012 §5) ───────────────────────────────────────
//
// Deposits are upstream's permissionless deposit_unshielded. The approval
// shows the token colour, the amount in base units, and the recipient's
// 32-byte user address; the mirror check and the send are the shared chip's.

// WithdrawUnshielded(bytes32 account,address device,uint64 authNonce,bytes32 color,uint128 amount,bytes32 recipient)
export circuit withdraw_unshielded_with_evm_eip712(
  color:     Bytes<32>,
  amount:    Uint<128>,
  recipient: UserAddress,
  auth:      EvmEip712Auth,
): [] {
  const [t, tail] = evm_eip712_parts_withdraw_unshielded(color, amount, recipient.bytes);
  require_authorised_with_evm_eip712<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>]>(auth, t, tail);
  do_withdraw_unshielded(color, amount, recipient);
}

// ── Custody: shielded (MIP-0012 §6) ─────────────────────────────────────────
//
// Deposits are upstream's permissionless deposit_shielded. The coin enters
// through the held_coin witness (never from ledger state), and the approval
// shows every value of it the spend consumes: the colour (as `color`), the
// nonce, the value and the Merkle index, and the change that returns to this
// account (value - amount). The digest is recomputed from the coin the
// witness actually returned, so a valid signature over one coin can never
// spend another (AUTH-10, FR-004).
//
// The colour is shown once, as `color`, and the export ASSERTS that the
// spent coin is of that colour (FR-010, audit C1, issue 00050): without it a
// dishonest prover could pair a valid signature over a coin of colour A with
// a witness coin of colour B carrying the same nonce, value and index. The
// amount is bounded by the coin's value before the change is computed.

// WithdrawShielded(bytes32 account,address device,uint64 authNonce,bytes32 color,uint128 amount,bytes32 recipient,
//                  bytes32 coinNonce,uint128 coinValue,uint64 coinMerkleIndex,uint128 change)
export circuit withdraw_shielded_with_evm_eip712(
  recipient: ZswapCoinPublicKey,
  color:     Bytes<32>,
  amount:    Uint<128>,
  auth:      EvmEip712Auth,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(color);
  assert(coin.color == color, "held coin colour does not match the withdrawn colour");
  assert(amount <= coin.value, "amount above the spent coin's value");
  const [t, tail] = evm_eip712_parts_withdraw_shielded(color, amount, recipient.bytes, coin.nonce, coin.value, coin.mt_index);
  require_authorised_with_evm_eip712<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>,
                                      Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(auth, t, tail);
  return do_withdraw_shielded(recipient, amount, coin);
}

// The contract-recipient spend: the direct-transfer mode of MIP-0012 §6.6
// (the output MUST be claimed by the receiving contract's deposit path in the
// same client-composed transaction; both addresses are public by design).
// The approval shows the recipient contract's 32-byte address; the coin, the
// colour assert and the change are as above. Returns [sent, change].

// WithdrawShieldedToContract(bytes32 account,address device,uint64 authNonce,bytes32 color,uint128 amount,
//                            bytes32 recipientContract,bytes32 coinNonce,uint128 coinValue,uint64 coinMerkleIndex,uint128 change)
export circuit withdraw_shielded_to_contract_with_evm_eip712(
  recipient: ContractAddress,
  color:     Bytes<32>,
  amount:    Uint<128>,
  auth:      EvmEip712Auth,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  assert(coin.color == color, "held coin colour does not match the withdrawn colour");
  assert(amount <= coin.value, "amount above the spent coin's value");
  const [t, tail] = evm_eip712_parts_withdraw_shielded_to_contract(color, amount, recipient.bytes,
    coin.nonce, coin.value, coin.mt_index);
  require_authorised_with_evm_eip712<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>,
                                      Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(auth, t, tail);
  return do_withdraw_shielded_to_contract(recipient, amount, coin);
}

// ── Custody: the inbox ──────────────────────────────────────────────────────
//
// The change-coin backfill (MIP-0012 §6.2), gated as on every arm. The
// approval shows the 192-byte InboxEntry v1 ciphertext in full, as `bytes`.

// AppendInbox(bytes32 account,address device,uint64 authNonce,bytes entry)
export circuit append_inbox_with_evm_eip712(entry: Bytes<192>, auth: EvmEip712Auth): [] {
  const [t, tail] = evm_eip712_parts_append_inbox(entry);
  require_authorised_with_evm_eip712<Bytes<32>>(auth, t, tail);
  do_append_inbox(entry);
}

// ── Device lifecycle (MIP-0013 §6) ──────────────────────────────────────────
//
// The other key is a readable DESCRIPTOR (spec FR-005, Q11-D, Q28): the
// target scheme's tag text and key payload (an EVM target by its address and
// privacy salt, a Solana target by its 32-byte key and privacy salt, a k256
// target by x, y and envelope, a passkey by x, y, its exact origin and the
// RP hash, a JubJub target by its point). The approval shows exactly those
// values, and the circuit derives the target's entry from them with the
// target scheme's own recipe (modules/WalletArmDescriptors, by payload-width
// class). An unregistered tag, or a registered tag of another recipe or
// width, is refused (the S1 tightening of FR-005), so a descriptor can never
// enrol an entry that no arm recognises by its tag.
//
// add_device derives at the CURRENT device_epoch and counter 0, never at a
// caller-chosen epoch or counter (FR-005): this arm cannot plant an entry at
// device_epoch + 1 (README erratum 7), whatever the descriptor says.

// AddDevice(bytes32 account,address device,uint64 authNonce,string effect,<Scheme>Device newDevice)
export circuit add_device_with_evm_eip712(new_device: EvmEip712Descriptor, auth: EvmEip712Auth): [] {
  const [t, tail] = evm_eip712_parts_add_device(new_device);
  require_authorised_with_evm_eip712<[Bytes<32>, Bytes<32>]>(auth, t, tail);
  do_add_device(evm_eip712_descriptor_entry(kernel.self(), new_device, device_epoch, 0 as Uint<64>));
}

// Two forms in one circuit (Q20):
//   - the target's descriptor with its epoch and use counter (removal only
//     reduces authority, so an explicit epoch is allowed: a device can evict
//     an entry planted at device_epoch + 1 by an upstream arm's raw
//     add_device), approved as
//     RemoveDevice(bytes32 account,address device,uint64 authNonce,<Scheme>Device target,uint32 targetEpoch,uint64 targetCounter);
//   - the revocation-only literal entry, for an entry the wallet cannot
//     describe (`unknown_entry` present), approved as
//     RemoveUnknownDevice(bytes32 account,address device,uint64 authNonce,string effect,bytes32 entry)
//     under the fixed line "Removes a device this wallet cannot identify".
//     The descriptor arguments are then unused (the client passes the zero
//     descriptor under the evm tag).
// Either way the caller's own post-roll entry can never be removed (AUTH-5,
// S13: do_remove_device's guard), nor the last device.
export circuit remove_device_with_evm_eip712(
  target:         EvmEip712Descriptor,
  target_epoch:   Uint<32>,
  target_counter: Uint<64>,
  unknown_entry:  Maybe<Bytes<32>>,
  auth:           EvmEip712Auth,
): [] {
  assert(unknown_entry.is_some || unknown_entry.value == default<Bytes<32>>, "noncanonical absent entry");
  const [t1, tail1] = evm_eip712_parts_remove_device(target, target_epoch, target_counter);
  const [t2, tail2] = evm_eip712_parts_remove_unknown_device(unknown_entry.value);
  const caller_entry = require_authorised_with_evm_eip712_either<[Bytes<32>, Bytes<28>, Bytes<4>, Bytes<24>, Bytes<8>], [Bytes<32>, Bytes<32>]>(
    auth, unknown_entry.is_some, t1, tail1, t2, tail2);
  const described = evm_eip712_descriptor_entry(kernel.self(), target, target_epoch, target_counter);
  do_remove_device(unknown_entry.is_some ? unknown_entry.value : described, caller_entry);
}
