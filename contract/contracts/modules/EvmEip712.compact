  // ── Words ─────────────────────────────────────────────────────────────────
  //
  // `v as Bytes<n>` is little-endian; EIP-712 integers are big-endian, so the
  // bytes are reversed (and the zero prefix is a separate tuple element).

  circuit rev4(b: Bytes<4>): Bytes<4> { return Bytes[b[3], b[2], b[1], b[0]]; }
  circuit rev8(b: Bytes<8>): Bytes<8> { return Bytes[b[7], b[6], b[5], b[4], b[3], b[2], b[1], b[0]]; }
  circuit rev16(b: Bytes<16>): Bytes<16> {
    return Bytes[b[15], b[14], b[13], b[12], b[11], b[10], b[9], b[8], b[7], b[6], b[5], b[4], b[3], b[2], b[1], b[0]];
  }
  circuit rev32(b: Bytes<32>): Bytes<32> {
    const v = b as Vector<32, Uint<8>>;
    return Bytes[v[31], v[30], v[29], v[28], v[27], v[26], v[25], v[24], v[23], v[22], v[21], v[20], v[19], v[18], v[17], v[16],
                 v[15], v[14], v[13], v[12], v[11], v[10], v[9],  v[8],  v[7],  v[6],  v[5],  v[4],  v[3],  v[2],  v[1],  v[0]];
  }
  circuit u32be(v: Uint<32>): Bytes<4> { return rev4(v as Bytes<4>); }
  circuit u64be(v: Uint<64>): Bytes<8> { return rev8(v as Bytes<8>); }
  circuit u128be(v: Uint<128>): Bytes<16> { return rev16(v as Bytes<16>); }
  circuit u8b(v: Uint<8>): Bytes<1> { return v as Bytes<1>; }
  circuit boolb(b: Boolean): Bytes<1> { return (b ? 1 : 0) as Uint<8> as Bytes<1>; }

  // ── Text ──────────────────────────────────────────────────────────────────

  // Exact visible ASCII (0x21..0x7e): a passkey origin, shown byte for byte.
  circuit visible_21(b: Bytes<21>): Boolean {
    return fold((ok: Boolean, c: Uint<8>): Boolean => ok && c >= 33 && c <= 126, true, b as Vector<21, Uint<8>>);
  }

  // A 32-byte site label: one or more words of visible ASCII separated by
  // single spaces, then zero bytes only (the grammar of the shared rendering
  // module's label_text_32). Returns the label as the wallet shows it, zero
  // bytes as spaces, and whether it follows the grammar; the grammar makes the
  // shown text one-to-one with the stored bytes.
  circuit label_text(label: Bytes<32>): [Bytes<32>, Boolean] {
    const v = label as Vector<32, Uint<8>>;
    // [the previous byte was a space (true before the first byte),
    //  the padding has begun, every byte fits]
    const r = fold((s: [Boolean, Boolean, Boolean], c: Uint<8>): [Boolean, Boolean, Boolean] => {
      const zero = c == 0;
      const space = c == 32;
      const shown = c >= 33 && c <= 126;
      const fits = s[1] ? zero
                 : zero ? !s[0]
                 : shown || (space && !s[0]);
      return [space, s[1] || zero, s[2] && fits];
    }, [true, false, true], v);
    const m = map((c: Uint<8>): Uint<8> => (c == 0 ? 32 : c) as Uint<8>, v);
    return [Bytes[m[0],  m[1],  m[2],  m[3],  m[4],  m[5],  m[6],  m[7],  m[8],  m[9],  m[10], m[11], m[12], m[13], m[14], m[15],
                  m[16], m[17], m[18], m[19], m[20], m[21], m[22], m[23], m[24], m[25], m[26], m[27], m[28], m[29], m[30], m[31]],
            r[2] && !r[0]];
  }

  // keccak256 of a site label as the wallet shows it (the `string siteLabel`).
  export pure circuit evm_eip712_site_label_hash(label: Bytes<32>): Bytes<32> {
    const [text, ok] = label_text(label);
    assert(ok, "evm_eip712: not a site label");
    return keccak256<Bytes<32>>(text);
  }

  // ── Domain and digest ─────────────────────────────────────────────────────

  export pure circuit evm_eip712_verifying_contract(account: Bytes<32>): Bytes<20> {
    return slice<20>(keccak256<Bytes<32>>(account), 12);
  }

  export pure circuit evm_eip712_domain_separator(account: Bytes<32>): Bytes<32> {
    return keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>]>([
      evm_eip712_domain_type_hash(), evm_eip712_name_hash(), evm_eip712_version_hash(),
      pad(12, ""), evm_eip712_verifying_contract(account)]);
  }

  // The 32 bytes the wallet signs for a message of this account.
  export pure circuit evm_eip712_digest(account: Bytes<32>, struct_hash: Bytes<32>): Bytes<32> {
    return keccak256<[Bytes<2>, Bytes<32>, Bytes<32>]>([
      Bytes[0x19, 0x01], evm_eip712_domain_separator(account), struct_hash]);
  }

  // ── Descriptors ───────────────────────────────────────────────────────────
  //
  // The scheme index (0 evm_eip712, 1 sol_ed25519, 2 jubjub, 3 k256, 4 p256)
  // selects the parent type hash. An unregistered tag is refused (the FR-005
  // tightening of S1: the descriptor module accepts only registered tags).

  export pure circuit evm_eip712_device_scheme(tag: Bytes<32>): Uint<8> {
    const is_evm = tag == device_tag_evm_eip712();
    const is_sol = tag == device_tag_sol_ed25519();
    const is_jub = tag == device_tag_jubjub();
    const is_k1  = tag == device_tag_k256();
    const is_r1  = tag == device_tag_p256();
    assert(is_evm || is_sol || is_jub || is_k1 || is_r1, "evm_eip712: not a registered device tag");
    return (is_evm ? 0 : is_sol ? 1 : is_jub ? 2 : is_k1 ? 3 : 4) as Uint<8>;
  }

  export pure circuit evm_eip712_grantee_scheme(tag: Bytes<32>): Uint<8> {
    const is_evm = tag == grant_id_tag_evm_eip712();
    const is_sol = tag == grant_id_tag_sol_ed25519();
    const is_jub = tag == grant_id_tag_jubjub();
    const is_k1  = tag == grant_id_tag_k256();
    const is_r1  = tag == grant_id_tag_p256();
    assert(is_evm || is_sol || is_jub || is_k1 || is_r1, "evm_eip712: not a registered grant-id tag");
    return (is_evm ? 0 : is_sol ? 1 : is_jub ? 2 : is_k1 ? 3 : 4) as Uint<8>;
  }

  // hashStruct of the nested <Scheme>Device member, and the scheme index.
  export pure circuit evm_eip712_device_descriptor_hash(d: EvmEip712Descriptor): [Bytes<32>, Uint<8>] {
    const s = evm_eip712_device_scheme(d.tag);
    assert(s != 4 || visible_21(d.origin), "evm_eip712: the passkey origin is not visible ASCII");
    const xb = rev32(d.key);
    const yb = rev32(d.key2);
    const h_evm = keccak256<[Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>, Bytes<32>]>([
      evm_eip712_type_evm_device(), evm_eip712_scheme_device_evm_v2(), pad(12, ""), d.address, d.key2]);
    // SolanaDevice(scheme, publicKey, privacySalt) and JubjubDevice(scheme, x, y)
    // share one shape; JubJub coordinates are shown little-endian (Q29).
    const h_pair = keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>]>([
      s == 1 ? evm_eip712_type_solana_device() : evm_eip712_type_jubjub_device(),
      s == 1 ? evm_eip712_scheme_device_sol_v1() : evm_eip712_scheme_device_v1(), d.key, d.key2]);
    const h_k1 = keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<31>, Bytes<1>]>([
      evm_eip712_type_k256_device(), evm_eip712_scheme_device_k1_v2(), xb, yb, pad(31, ""), u8b(d.envelope)]);
    const h_r1 = keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>]>([
      evm_eip712_type_passkey_device(), evm_eip712_scheme_device_r1_v2(), xb, yb,
      keccak256<Bytes<21>>(d.origin), d.rp_id_hash]);
    return [s == 0 ? h_evm : (s == 1 || s == 2) ? h_pair : s == 3 ? h_k1 : h_r1, s];
  }

  // The target's entry at (epoch, counter), by the target scheme's own recipe.
  // Every width class is derived (a circuit has no branches); the classes that
  // do not match are fed a registered tag of their own width, so the module's
  // width asserts hold, and their results are discarded.
  export pure circuit evm_eip712_descriptor_entry(
    self_addr: ContractAddress, d: EvmEip712Descriptor, epoch: Uint<32>, counter: Uint<64>
  ): Bytes<32> {
    const s = evm_eip712_device_scheme(d.tag);
    const e52 = derive_descriptor_entry_w52(s == 0 ? d.tag : device_tag_evm_eip712(),
      self_addr, d.address, d.key2, epoch, counter);
    const e64 = derive_descriptor_entry_w64((s == 1 || s == 2) ? d.tag : device_tag_jubjub(),
      self_addr, d.key, d.key2, epoch, counter);
    const e65 = derive_descriptor_entry_w65(s == 3 ? d.tag : device_tag_k256(),
      self_addr, d.key, d.key2, d.envelope, epoch, counter);
    const e117 = derive_descriptor_entry_w117(s == 4 ? d.tag : device_tag_p256(),
      self_addr, d.key, d.key2, d.rp_id_hash, d.origin, epoch, counter);
    return s == 0 ? e52 : (s == 1 || s == 2) ? e64 : s == 3 ? e65 : e117;
  }

  // The origin_hash a grantee's grant id binds.
  export pure circuit evm_eip712_grantee_origin_hash(g: EvmEip712GranteeDescriptor): Bytes<32> {
    const s = evm_eip712_grantee_scheme(g.tag);
    const from_label = derive_grant_origin_hash_label(g.label);
    const from_origin = derive_grant_origin_hash_origin(g.origin);
    return (s == 0 || s == 1) ? from_label : s == 4 ? from_origin : g.origin_hash;
  }

  // The grantee's grant id, by the grantee scheme's own grant-id recipe.
  export pure circuit evm_eip712_grantee_grant_id(self_addr: ContractAddress, g: EvmEip712GranteeDescriptor): Bytes<32> {
    const s = evm_eip712_grantee_scheme(g.tag);
    const oh = evm_eip712_grantee_origin_hash(g);
    const i52 = derive_descriptor_grant_id_w52(s == 0 ? g.tag : grant_id_tag_evm_eip712(),
      self_addr, g.address, g.key2, oh, g.slot);
    const i64 = derive_descriptor_grant_id_w64((s == 1 || s == 2 || s == 4) ? g.tag : grant_id_tag_jubjub(),
      self_addr, g.key, g.key2, oh, g.slot);
    const i65 = derive_descriptor_grant_id_w65(s == 3 ? g.tag : grant_id_tag_k256(),
      self_addr, g.key, g.key2, g.envelope, oh, g.slot);
    return s == 0 ? i52 : s == 3 ? i65 : i64;
  }

  // hashStruct of the nested <Scheme>Grantee member, and the scheme index.
  export pure circuit evm_eip712_grantee_descriptor_hash(g: EvmEip712GranteeDescriptor): [Bytes<32>, Uint<8>] {
    const s = evm_eip712_grantee_scheme(g.tag);
    const [text, label_ok] = label_text(g.label);
    assert(!(s == 0 || s == 1) || label_ok, "evm_eip712: not a site label");
    assert(s != 4 || visible_21(g.origin), "evm_eip712: the passkey origin is not visible ASCII");
    const label_hash = keccak256<Bytes<32>>(text);
    const xb = rev32(g.key);
    const yb = rev32(g.key2);
    const h_evm = keccak256<[Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>, Bytes<32>, Bytes<32>, Bytes<31>, Bytes<1>]>([
      evm_eip712_type_evm_grantee(), evm_eip712_scheme_grant_id_evm_v2(), pad(12, ""), g.address, g.key2,
      label_hash, pad(31, ""), u8b(g.slot)]);
    // SolanaGrantee(scheme, publicKey, privacySalt, siteLabel, slot),
    // JubjubGrantee(scheme, x, y, siteLabelHash, slot) and
    // PasskeyGrantee(scheme, x, y, origin, slot) share one shape.
    const h_six = keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<31>, Bytes<1>]>([
      s == 1 ? evm_eip712_type_solana_grantee() : s == 2 ? evm_eip712_type_jubjub_grantee() : evm_eip712_type_passkey_grantee(),
      s == 1 ? evm_eip712_scheme_grant_id_sol_v1() : s == 2 ? evm_eip712_scheme_grant_id_v1() : evm_eip712_scheme_grant_id_r1_v1(),
      s == 4 ? xb : g.key, s == 4 ? yb : g.key2,
      s == 1 ? label_hash : s == 2 ? g.origin_hash : keccak256<Bytes<21>>(g.origin),
      pad(31, ""), u8b(g.slot)]);
    const h_k1 = keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<31>, Bytes<1>, Bytes<32>, Bytes<31>, Bytes<1>]>([
      evm_eip712_type_k256_grantee(), evm_eip712_scheme_grant_id_k1_v1(), xb, yb, pad(31, ""), u8b(g.envelope),
      g.origin_hash, pad(31, ""), u8b(g.slot)]);
    return [s == 0 ? h_evm : s == 3 ? h_k1 : h_six, s];
  }

  // ── The frames ────────────────────────────────────────────────────────────
  //
  // Every device-role primary type begins with the same frame,
  //   typeHash, bytes32 account, address device, uint64 authNonce,
  // and every grantee-role type with
  //   typeHash, bytes32 account, address grantee, string siteLabel,
  //   uint8 slot, uint64 issuedAt, uint64 grantNonce,
  // followed by the operation's own members (its "tail"). The frame builders
  // below are the only place the frame is encoded: the exported struct-hash
  // oracles use them, and so does the arm's seam, which supplies the frame's
  // values itself (the account is kernel.self(), the device the address of
  // the presented point, the nonce the ledger's) — so no export can ever name
  // a frame value (audit G1E-1, G0 C9). Each operation's type hash and tail
  // come from its `evm_eip712_parts_*` circuit, shared by the oracle and the
  // export. The tail is a tuple of byte atoms and is hashed in place, flat
  // (keccak256 of a tuple encodes its elements in declaration order).

  export circuit evm_eip712_device_struct<T>(
    type_hash: Bytes<32>, account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, tail: T
  ): Bytes<32> {
    return keccak256<[Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>, Bytes<24>, Bytes<8>, T]>([
      type_hash, account, pad(12, ""), device, pad(24, ""), u64be(auth_nonce), tail]);
  }

  // The device-role types with no members of their own (RevokeAllGrants,
  // CancelRecovery): the frame alone.
  export circuit evm_eip712_device_struct_bare(
    type_hash: Bytes<32>, account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>
  ): Bytes<32> {
    return keccak256<[Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>, Bytes<24>, Bytes<8>]>([
      type_hash, account, pad(12, ""), device, pad(24, ""), u64be(auth_nonce)]);
  }

  export circuit evm_eip712_grantee_struct<T>(
    type_hash: Bytes<32>, account: Bytes<32>, grantee: Bytes<20>, label: Bytes<32>, slot: Uint<8>,
    issued_at: Uint<64>, grant_nonce: Uint<64>, tail: T
  ): Bytes<32> {
    return keccak256<[Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>, Bytes<32>, Bytes<31>, Bytes<1>,
                      Bytes<24>, Bytes<8>, Bytes<24>, Bytes<8>, T]>([
      type_hash, account, pad(12, ""), grantee, evm_eip712_site_label_hash(label), pad(31, ""), u8b(slot),
      pad(24, ""), u64be(issued_at), pad(24, ""), u64be(grant_nonce), tail]);
  }

  // ── Parts: each operation's type hash and tail ────────────────────────────

  // color, amount, recipient
  export circuit evm_eip712_parts_withdraw_unshielded(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>]] {
    return [evm_eip712_type_withdraw_unshielded(), [color, pad(16, ""), u128be(amount), recipient]];
  }

  // The spent coin is shown by its nonce, value and Merkle index; its colour is
  // `color` (the exports assert coin.color == color); change = value - amount.
  circuit coin_tail(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>
  ): [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>] {
    const change = (coin_value - amount) as Uint<128>;
    return [color, pad(16, ""), u128be(amount), recipient,
            coin_nonce, pad(16, ""), u128be(coin_value), pad(24, ""), u64be(coin_mt_index), pad(16, ""), u128be(change)];
  }

  export circuit evm_eip712_parts_withdraw_shielded(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]] {
    return [evm_eip712_type_withdraw_shielded(), coin_tail(color, amount, recipient, coin_nonce, coin_value, coin_mt_index)];
  }

  export circuit evm_eip712_parts_withdraw_shielded_to_contract(
    color: Bytes<32>, amount: Uint<128>, recipient_contract: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]] {
    return [evm_eip712_type_withdraw_shielded_to_contract(),
            coin_tail(color, amount, recipient_contract, coin_nonce, coin_value, coin_mt_index)];
  }

  // `bytes entry`: the 192-byte InboxEntry v1 ciphertext, shown in full hex.
  export circuit evm_eip712_parts_append_inbox(entry: Bytes<192>): [Bytes<32>, Bytes<32>] {
    return [evm_eip712_type_append_inbox(), keccak256<Bytes<192>>(entry)];
  }

  export circuit evm_eip712_parts_rotate_enc_key(new_key: Bytes<32>): [Bytes<32>, [Bytes<32>, Bytes<32>]] {
    return [evm_eip712_type_rotate_enc_key(), [evm_eip712_effect_rotate_enc_key(), new_key]];
  }

  export circuit evm_eip712_parts_add_device(new_device: EvmEip712Descriptor): [Bytes<32>, [Bytes<32>, Bytes<32>]] {
    const [child, s] = evm_eip712_device_descriptor_hash(new_device);
    const t = s == 0 ? evm_eip712_type_add_device__evm() : s == 1 ? evm_eip712_type_add_device__solana()
            : s == 2 ? evm_eip712_type_add_device__jubjub() : s == 3 ? evm_eip712_type_add_device__k256()
            : evm_eip712_type_add_device__passkey();
    return [t, [evm_eip712_effect_add_device(), child]];
  }

  export circuit evm_eip712_parts_remove_device(
    target: EvmEip712Descriptor, target_epoch: Uint<32>, target_counter: Uint<64>
  ): [Bytes<32>, [Bytes<32>, Bytes<28>, Bytes<4>, Bytes<24>, Bytes<8>]] {
    const [child, s] = evm_eip712_device_descriptor_hash(target);
    const t = s == 0 ? evm_eip712_type_remove_device__evm() : s == 1 ? evm_eip712_type_remove_device__solana()
            : s == 2 ? evm_eip712_type_remove_device__jubjub() : s == 3 ? evm_eip712_type_remove_device__k256()
            : evm_eip712_type_remove_device__passkey();
    return [t, [child, pad(28, ""), u32be(target_epoch), pad(24, ""), u64be(target_counter)]];
  }

  // The revocation-only literal form (Q20): the entry under a fixed line.
  export circuit evm_eip712_parts_remove_unknown_device(entry: Bytes<32>): [Bytes<32>, [Bytes<32>, Bytes<32>]] {
    return [evm_eip712_type_remove_unknown_device(), [evm_eip712_effect_remove_unknown_device(), entry]];
  }

  // Every scope field, the grantee descriptor, the RP hash (a passkey grantee's
  // labelled value; zero otherwise), the delegate's read key itself (its hash is
  // what the record stores; zero when `read` is off), and the caller pin.
  export circuit evm_eip712_parts_issue_grant(
    grantee: EvmEip712GranteeDescriptor,
    op_withdraw_unshielded: Boolean, op_withdraw_shielded: Boolean, op_withdraw_shielded_to_contract: Boolean,
    read: Boolean, color: Bytes<32>, recipient_kind: Uint<8>, recipient: Bytes<32>, max_coin_value: Uint<128>,
    per_call_cap: Uint<128>, cap: Uint<128>, expires_at: Uint<64>, rp_id_hash: Bytes<32>, read_pk: Bytes<32>,
    window_len: Uint<64>, window_cap: Uint<128>, caller: Maybe<ContractAddress>
  ): [Bytes<32>, [Bytes<32>, Bytes<32>,
                  Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>,
                  Bytes<32>, Bytes<31>, Bytes<1>, Bytes<32>,
                  Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>,
                  Bytes<24>, Bytes<8>, Bytes<32>, Bytes<32>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>,
                  Bytes<31>, Bytes<1>, Bytes<32>]] {
    const [child, s] = evm_eip712_grantee_descriptor_hash(grantee);
    const t = s == 0 ? evm_eip712_type_issue_grant__evm() : s == 1 ? evm_eip712_type_issue_grant__solana()
            : s == 2 ? evm_eip712_type_issue_grant__jubjub() : s == 3 ? evm_eip712_type_issue_grant__k256()
            : evm_eip712_type_issue_grant__passkey();
    return [t, [evm_eip712_effect_issue_grant(), child,
      pad(31, ""), boolb(op_withdraw_unshielded), pad(31, ""), boolb(op_withdraw_shielded),
      pad(31, ""), boolb(op_withdraw_shielded_to_contract), pad(31, ""), boolb(read),
      color, pad(31, ""), u8b(recipient_kind), recipient,
      pad(16, ""), u128be(max_coin_value), pad(16, ""), u128be(per_call_cap), pad(16, ""), u128be(cap),
      pad(24, ""), u64be(expires_at), rp_id_hash, read ? read_pk : pad(32, ""), pad(24, ""), u64be(window_len),
      pad(16, ""), u128be(window_cap),
      pad(31, ""), boolb(caller.is_some), caller.is_some ? caller.value.bytes : pad(32, "")]];
  }

  export circuit evm_eip712_parts_revoke_grant(grantee: EvmEip712GranteeDescriptor): [Bytes<32>, Bytes<32>] {
    const [child, s] = evm_eip712_grantee_descriptor_hash(grantee);
    const t = s == 0 ? evm_eip712_type_revoke_grant__evm() : s == 1 ? evm_eip712_type_revoke_grant__solana()
            : s == 2 ? evm_eip712_type_revoke_grant__jubjub() : s == 3 ? evm_eip712_type_revoke_grant__k256()
            : evm_eip712_type_revoke_grant__passkey();
    return [t, child];
  }

  export circuit evm_eip712_parts_revoke_all_grants(): Bytes<32> {
    return evm_eip712_type_revoke_all_grants();
  }

  // JubJub coordinates and the phi Field values are shown little-endian (Q29);
  // `bytes wrap` is the 64-byte wrap in full.
  export circuit evm_eip712_parts_publish_recovery_session(
    new_recovery_pk: JubjubPoint, session_nonce: Bytes<32>, phi_1: Field, phi_2: Field, phi_3: Field, phi_4: Field,
    phi_len: Uint<8>, wrap: Bytes<64>
  ): [Bytes<32>, [Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                  Bytes<31>, Bytes<1>, Bytes<32>]] {
    return [evm_eip712_type_publish_recovery_session(), [evm_eip712_effect_publish_recovery_session(),
      jubjubPointX(new_recovery_pk) as Bytes<32>, jubjubPointY(new_recovery_pk) as Bytes<32>, session_nonce,
      phi_1 as Bytes<32>, phi_2 as Bytes<32>, phi_3 as Bytes<32>, phi_4 as Bytes<32>,
      pad(31, ""), u8b(phi_len), keccak256<Bytes<64>>(wrap)]];
  }

  export circuit evm_eip712_parts_cancel_recovery(): Bytes<32> {
    return evm_eip712_type_cancel_recovery();
  }

  // The grantee role: color, amount, recipient (+ the change entry, its key and
  // the coin for the shielded twins).
  export circuit evm_eip712_parts_withdraw_unshielded_as_grantee(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>]] {
    return [evm_eip712_type_withdraw_unshielded_as_grantee(), [color, pad(16, ""), u128be(amount), recipient]];
  }

  circuit grantee_coin_tail(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>, change_entry: Bytes<192>, enc_pk: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>
  ): [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>,
      Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>] {
    const change = (coin_value - amount) as Uint<128>;
    return [color, pad(16, ""), u128be(amount), recipient, keccak256<Bytes<192>>(change_entry), enc_pk,
            coin_nonce, pad(16, ""), u128be(coin_value), pad(24, ""), u64be(coin_mt_index), pad(16, ""), u128be(change)];
  }

  export circuit evm_eip712_parts_withdraw_shielded_as_grantee(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>, change_entry: Bytes<192>, enc_pk: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>,
                  Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]] {
    return [evm_eip712_type_withdraw_shielded_as_grantee(),
            grantee_coin_tail(color, amount, recipient, change_entry, enc_pk, coin_nonce, coin_value, coin_mt_index)];
  }

  export circuit evm_eip712_parts_withdraw_shielded_to_contract_as_grantee(
    color: Bytes<32>, amount: Uint<128>, recipient_contract: Bytes<32>, change_entry: Bytes<192>, enc_pk: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>,
                  Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]] {
    return [evm_eip712_type_withdraw_shielded_to_contract_as_grantee(),
            grantee_coin_tail(color, amount, recipient_contract, change_entry, enc_pk, coin_nonce, coin_value, coin_mt_index)];
  }

  // ── Struct hashes: the exported oracles (frame + parts) ───────────────────

  export pure circuit evm_eip712_struct_withdraw_unshielded(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>,
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_withdraw_unshielded(color, amount, recipient);
    return evm_eip712_device_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>]>(t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_withdraw_shielded(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>,
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_withdraw_shielded(color, amount, recipient, coin_nonce, coin_value, coin_mt_index);
    return evm_eip712_device_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(
      t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_withdraw_shielded_to_contract(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>,
    color: Bytes<32>, amount: Uint<128>, recipient_contract: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_withdraw_shielded_to_contract(color, amount, recipient_contract, coin_nonce, coin_value, coin_mt_index);
    return evm_eip712_device_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(
      t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_append_inbox(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, entry: Bytes<192>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_append_inbox(entry);
    return evm_eip712_device_struct<Bytes<32>>(t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_rotate_enc_key(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, new_key: Bytes<32>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_rotate_enc_key(new_key);
    return evm_eip712_device_struct<[Bytes<32>, Bytes<32>]>(t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_add_device(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, new_device: EvmEip712Descriptor
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_add_device(new_device);
    return evm_eip712_device_struct<[Bytes<32>, Bytes<32>]>(t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_remove_device(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, target: EvmEip712Descriptor,
    target_epoch: Uint<32>, target_counter: Uint<64>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_remove_device(target, target_epoch, target_counter);
    return evm_eip712_device_struct<[Bytes<32>, Bytes<28>, Bytes<4>, Bytes<24>, Bytes<8>]>(t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_remove_unknown_device(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, entry: Bytes<32>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_remove_unknown_device(entry);
    return evm_eip712_device_struct<[Bytes<32>, Bytes<32>]>(t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_issue_grant(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, grantee: EvmEip712GranteeDescriptor,
    op_withdraw_unshielded: Boolean, op_withdraw_shielded: Boolean, op_withdraw_shielded_to_contract: Boolean,
    read: Boolean, color: Bytes<32>, recipient_kind: Uint<8>, recipient: Bytes<32>, max_coin_value: Uint<128>,
    per_call_cap: Uint<128>, cap: Uint<128>, expires_at: Uint<64>, rp_id_hash: Bytes<32>, read_pk: Bytes<32>,
    window_len: Uint<64>, window_cap: Uint<128>, caller: Maybe<ContractAddress>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_issue_grant(grantee, op_withdraw_unshielded, op_withdraw_shielded,
      op_withdraw_shielded_to_contract, read, color, recipient_kind, recipient, max_coin_value, per_call_cap, cap,
      expires_at, rp_id_hash, read_pk, window_len, window_cap, caller);
    return evm_eip712_device_struct<[Bytes<32>, Bytes<32>,
                                     Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>,
                                     Bytes<32>, Bytes<31>, Bytes<1>, Bytes<32>,
                                     Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>,
                                     Bytes<24>, Bytes<8>, Bytes<32>, Bytes<32>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>,
                                     Bytes<31>, Bytes<1>, Bytes<32>]>(t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_revoke_grant(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, grantee: EvmEip712GranteeDescriptor
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_revoke_grant(grantee);
    return evm_eip712_device_struct<Bytes<32>>(t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_revoke_all_grants(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>
  ): Bytes<32> {
    return evm_eip712_device_struct_bare(evm_eip712_parts_revoke_all_grants(), account, device, auth_nonce);
  }

  export pure circuit evm_eip712_struct_publish_recovery_session(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, new_recovery_pk: JubjubPoint,
    session_nonce: Bytes<32>, phi_1: Field, phi_2: Field, phi_3: Field, phi_4: Field,
    phi_len: Uint<8>, wrap: Bytes<64>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_publish_recovery_session(new_recovery_pk, session_nonce,
      phi_1, phi_2, phi_3, phi_4, phi_len, wrap);
    return evm_eip712_device_struct<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                                     Bytes<31>, Bytes<1>, Bytes<32>]>(t, account, device, auth_nonce, tail);
  }

  export pure circuit evm_eip712_struct_cancel_recovery(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>
  ): Bytes<32> {
    return evm_eip712_device_struct_bare(evm_eip712_parts_cancel_recovery(), account, device, auth_nonce);
  }

  // The grantee role: the grant is shown by its descriptor without the
  // signer's own blind (a ledger-pinned opening): the grantee's address, site
  // label and slot, then the record's issuedAt and nonce (never auth_nonce).

  export pure circuit evm_eip712_struct_withdraw_unshielded_as_grantee(
    account: Bytes<32>, grantee: Bytes<20>, label: Bytes<32>, slot: Uint<8>,
    issued_at: Uint<64>, grant_nonce: Uint<64>,
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_withdraw_unshielded_as_grantee(color, amount, recipient);
    return evm_eip712_grantee_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>]>(
      t, account, grantee, label, slot, issued_at, grant_nonce, tail);
  }

  export pure circuit evm_eip712_struct_withdraw_shielded_as_grantee(
    account: Bytes<32>, grantee: Bytes<20>, label: Bytes<32>, slot: Uint<8>,
    issued_at: Uint<64>, grant_nonce: Uint<64>,
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>, change_entry: Bytes<192>, enc_pk: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_withdraw_shielded_as_grantee(color, amount, recipient, change_entry, enc_pk,
      coin_nonce, coin_value, coin_mt_index);
    return evm_eip712_grantee_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>,
                                      Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(
      t, account, grantee, label, slot, issued_at, grant_nonce, tail);
  }

  export pure circuit evm_eip712_struct_withdraw_shielded_to_contract_as_grantee(
    account: Bytes<32>, grantee: Bytes<20>, label: Bytes<32>, slot: Uint<8>,
    issued_at: Uint<64>, grant_nonce: Uint<64>,
    color: Bytes<32>, amount: Uint<128>, recipient_contract: Bytes<32>, change_entry: Bytes<192>, enc_pk: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>
  ): Bytes<32> {
    const [t, tail] = evm_eip712_parts_withdraw_shielded_to_contract_as_grantee(color, amount, recipient_contract,
      change_entry, enc_pk, coin_nonce, coin_value, coin_mt_index);
    return evm_eip712_grantee_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>,
                                      Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(
      t, account, grantee, label, slot, issued_at, grant_nonce, tail);
  }
}
