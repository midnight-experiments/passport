export circuit probe_boot_w117(
  tag: Bytes<32>, salt: Bytes<32>, x: Bytes<32>, y: Bytes<32>, rp_id_hash: Bytes<32>, origin: Bytes<21>
): [] {
  derived = disclose(derive_descriptor_boot_w117(tag, salt, x, y, rp_id_hash, origin));
