  tag: Bytes<32>, self_addr: ContractAddress, first: Bytes<32>, second: Bytes<32>,
  origin_hash: Bytes<32>, slot: Uint<8>
): [] {
  derived = disclose(derive_descriptor_grant_id_w64(tag, self_addr, first, second, origin_hash, slot));
